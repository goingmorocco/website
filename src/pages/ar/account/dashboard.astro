---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="ar"
  title="لوحتي | GoingMorocco"
  description="لوحة تحكم عضو GoingMorocco."
  alternateUrls={{ en: "/account/dashboard/", ar: "/ar/account/dashboard/" }}
>
  <Container class="max-w-2xl py-16">
    <div id="dashboard-loading" class="text-center text-ink/50">جارٍ التحميل…</div>

    <div id="dashboard-content" class="hidden">
      <h1 class="font-display text-3xl text-ink">مرحباً بعودتك، <span id="dashboard-name"></span></h1>
      <p class="mt-2 text-ink/70">أدر منشوراتك في المنتدى من هنا.</p>

      <div class="mt-6">
        <a href="/ar/forum/" class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark">
          + كتابة منشور جديد
        </a>
      </div>

      <h2 class="mt-10 font-display text-xl text-ink">منشوراتي</h2>

      <div id="my-posts-loading" class="mt-4 text-ink/50">جارٍ تحميل منشوراتك…</div>
      <div id="my-posts-empty" class="mt-4 hidden rounded-xl border border-dashed border-sand-light p-6 text-center text-ink/50">
        لم تكتب أي منشور بعد.
      </div>
      <div id="my-posts-list" class="mt-4 hidden space-y-3"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";

  const loadingEl = document.getElementById("dashboard-loading")!;
  const contentEl = document.getElementById("dashboard-content")!;
  const postsLoadingEl = document.getElementById("my-posts-loading")!;
  const postsEmptyEl = document.getElementById("my-posts-empty")!;
  const postsListEl = document.getElementById("my-posts-list")!;

  async function loadMyPosts(userId: string) {
    const { data: threads, error } = await supabase
      .from("forum_threads")
      .select("slug, title, created_at, forum_categories(name_ar)")
      .eq("author_id", userId)
      .order("created_at", { ascending: false });

    postsLoadingEl.classList.add("hidden");

    if (error || !threads || threads.length === 0) {
      postsEmptyEl.classList.remove("hidden");
      return;
    }

    postsListEl.innerHTML = threads
      .map((t: any) => {
        const date = new Date(t.created_at).toLocaleDateString("ar", { year: "numeric", month: "short", day: "numeric" });
        const categoryName = t.forum_categories?.name_ar ?? "";
        return `
          <div class="flex items-center justify-between rounded-xl border border-sand-light bg-white p-4">
            <div>
              <a href="/ar/forum/thread/?slug=${encodeURIComponent(t.slug)}" class="font-medium text-ink hover:text-royal">${t.title}</a>
              <p class="mt-0.5 text-xs text-ink/50">${categoryName} · ${date}</p>
            </div>
            <div class="flex gap-3">
              <a href="/ar/account/dashboard/edit-thread/?slug=${encodeURIComponent(t.slug)}" class="text-sm text-royal hover:underline">تعديل</a>
              <button data-delete-slug="${t.slug}" class="text-sm text-red-500 hover:underline">حذف</button>
            </div>
          </div>
        `;
      })
      .join("");
    postsListEl.classList.remove("hidden");

    postsListEl.querySelectorAll<HTMLButtonElement>("[data-delete-slug]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("حذف هذا المنشور؟ لا يمكن التراجع عن هذا الإجراء.")) return;
        const slug = btn.dataset.deleteSlug!;
        const { error: deleteError } = await supabase.from("forum_threads").delete().eq("slug", slug);
        if (deleteError) {
          alert(`تعذّر الحذف: ${deleteError.message}`);
          return;
        }
        btn.closest("div.flex")!.parentElement!.remove();
        if (!postsListEl.querySelector("[data-delete-slug]")) {
          postsListEl.classList.add("hidden");
          postsEmptyEl.classList.remove("hidden");
        }
      });
    });
  }

  async function init() {
    const { data } = await supabase.auth.getSession();

    if (!data.session) {
      window.location.href = "/ar/account/login/";
      return;
    }

    const { data: profile } = await supabase
      .from("profiles")
      .select("display_name, username")
      .eq("id", data.session.user.id)
      .single();

    document.getElementById("dashboard-name")!.textContent =
      profile?.display_name || profile?.username || "بك";

    loadingEl.classList.add("hidden");
    contentEl.classList.remove("hidden");

    loadMyPosts(data.session.user.id);
  }

  init();
</script>
