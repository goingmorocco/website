---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Container from "../../../../components/Container.astro";

export function getStaticPaths() {
  const categories = [
    { slug: "my-experience", nameEn: "My Experience in Morocco", nameAr: "تجربتي في المغرب" },
    { slug: "hotels", nameEn: "Hotels in Morocco", nameAr: "الفنادق في المغرب" },
    { slug: "reviews", nameEn: "Reviews & Recommendations", nameAr: "التقييمات والتوصيات" },
    { slug: "services", nameEn: "Other Travel Services", nameAr: "خدمات سفر أخرى" },
  ];
  return categories.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;
---

<BaseLayout
  locale="ar"
  title={`${cat.nameAr} | منتدى GoingMorocco`}
  description={`${cat.nameAr} — اقرأ وشارك منشورات في هذه الفئة.`}
  alternateUrls={{ en: `/forum/${cat.slug}/`, ar: `/ar/forum/${cat.slug}/` }}
>
  <Container class="max-w-3xl py-16">
    <div data-category-slug={cat.slug}>
      <a href="/ar/forum/" class="text-sm text-royal hover:underline">→ جميع الفئات</a>
      <div class="mt-3 flex items-center justify-between">
        <h1 class="font-display text-3xl text-ink">{cat.nameAr}</h1>
        <a
          href={`/ar/account/dashboard/new-thread/?category=${cat.slug}`}
          class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark"
        >
          + منشور جديد
        </a>
      </div>

      <div id="threads-loading" class="mt-8 text-ink/50">جارٍ تحميل المنشورات…</div>
      <div id="threads-empty" class="mt-8 hidden text-ink/50">لا توجد منشورات هنا بعد — كن أول من يشارك شيئاً.</div>
      <div id="threads-list" class="mt-8 hidden space-y-4"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../../utils/supabaseClient";

  const loadingEl = document.getElementById("threads-loading")!;
  const emptyEl = document.getElementById("threads-empty")!;
  const listEl = document.getElementById("threads-list")!;
  const categorySlug = document.querySelector<HTMLElement>("[data-category-slug]")!.dataset.categorySlug!;

  async function loadThreads() {
    const { data: category } = await supabase
      .from("forum_categories")
      .select("id")
      .eq("slug", categorySlug)
      .single();

    if (!category) {
      loadingEl.textContent = "الفئة غير موجودة.";
      return;
    }

    const { data: threads, error } = await supabase
      .from("forum_threads")
      .select("slug, title, created_at, profiles(username, display_name)")
      .eq("category_id", category.id)
      .order("created_at", { ascending: false });

    loadingEl.classList.add("hidden");

    if (error || !threads || threads.length === 0) {
      emptyEl.classList.remove("hidden");
      return;
    }

    listEl.innerHTML = threads
      .map((t: any) => {
        const author = t.profiles?.display_name || t.profiles?.username || "أحد الأعضاء";
        const date = new Date(t.created_at).toLocaleDateString("ar", { year: "numeric", month: "short", day: "numeric" });
        return `
          <a href="/ar/forum/thread/?slug=${encodeURIComponent(t.slug)}" class="block rounded-xl border border-sand-light bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <h2 class="font-display text-lg text-ink">${t.title}</h2>
            <p class="mt-1 text-sm text-ink/50">بواسطة ${author} · ${date}</p>
          </a>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");
  }

  loadThreads();
</script>
