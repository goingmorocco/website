---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Posts | Admin | GoingMorocco"
  description="Moderate GoingMorocco forum posts."
  alternateUrls={{ en: "/admin/posts/", ar: "/admin/posts/" }}
>
  <Container class="max-w-4xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <h1 class="mt-2 font-display text-3xl text-ink">Forum Posts</h1>

      <div id="posts-loading" class="mt-6 text-ink/50">Loading posts…</div>
      <div id="posts-list" class="mt-6 hidden space-y-3"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";
  import { requireAdmin } from "../../../utils/adminGuard";

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  async function loadPosts() {
    const { data: threads, error } = await supabase
      .from("forum_threads")
      .select("id, slug, title, created_at, profiles(username, display_name), forum_categories(name_en)")
      .order("created_at", { ascending: false });

    document.getElementById("posts-loading")!.classList.add("hidden");
    if (error || !threads) return;

    const listEl = document.getElementById("posts-list")!;
    listEl.innerHTML = threads
      .map((t: any) => {
        const author = t.profiles?.display_name || t.profiles?.username || "Someone";
        const category = t.forum_categories?.name_en ?? "";
        const date = new Date(t.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        return `
          <div class="flex items-center justify-between rounded-xl border border-sand-light bg-white p-4">
            <div>
              <a href="/forum/thread/?slug=${encodeURIComponent(t.slug)}" class="font-medium text-ink hover:text-royal">${escapeHtml(t.title)}</a>
              <p class="mt-0.5 text-xs text-ink/50">${escapeHtml(author)} · ${escapeHtml(category)} · ${date}</p>
            </div>
            <button data-delete="${t.id}" class="text-sm text-red-500 hover:underline">Delete</button>
          </div>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");

    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Delete this post? This can't be undone.")) return;
        const { error: deleteError } = await supabase.from("forum_threads").delete().eq("id", btn.dataset.delete!);
        if (deleteError) {
          alert(`Couldn't delete: ${deleteError.message}`);
          return;
        }
        loadPosts();
      });
    });
  }

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    loadPosts();
  }

  init();
</script>
