---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Blog Posts | Admin | GoingMorocco"
  description="Manage GoingMorocco blog posts."
  alternateUrls={{ en: "/admin/blog-posts/", ar: "/admin/blog-posts/" }}
>
  <Container class="max-w-3xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <div class="mt-2 flex items-center justify-between">
        <h1 class="font-display text-3xl text-ink">Blog Posts</h1>
        <a href="/admin/write-post/" class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark">
          + New Post
        </a>
      </div>

      <input id="search" type="text" placeholder="Filter by slug…"
        class="mt-4 w-full max-w-sm rounded-lg border border-sand-light px-3 py-2 text-sm" />

      <div class="mt-6 flex gap-2 border-b border-sand-light">
        <button data-tab="en" class="tab-btn border-b-2 border-royal px-3 py-2 text-sm font-medium text-royal">English</button>
        <button data-tab="ar" class="tab-btn border-b-2 border-transparent px-3 py-2 text-sm font-medium text-ink/60 hover:text-royal">Arabic</button>
      </div>

      <div id="posts-loading" class="mt-4 text-ink/50">Loading posts from GitHub…</div>
      <div id="tab-en" class="tab-panel mt-4 space-y-2"></div>
      <div id="tab-ar" class="tab-panel mt-4 hidden space-y-2"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { requireAdmin } from "../../../utils/adminGuard";

  // Public read — no token needed, this is just your already-public repo content.
  const GITHUB_REPO = "goingmorocco/website";

  let allPosts: { en: string[]; ar: string[] } = { en: [], ar: [] };
  let fetchErrors: string[] = [];

  async function fetchPostList(locale: "en" | "ar"): Promise<string[]> {
    const res = await fetch(`https://api.github.com/repos/${GITHUB_REPO}/contents/src/content/blog/${locale}`);
    if (!res.ok) {
      fetchErrors.push(`${locale}: GitHub API returned ${res.status} — check GITHUB_REPO is set correctly, or that you haven't hit GitHub's anonymous rate limit (60 requests/hour).`);
      return [];
    }
    const files = await res.json();
    return files
      .filter((f: any) => f.name.endsWith(".mdx") || f.name.endsWith(".md"))
      .map((f: any) => f.name.replace(/\.mdx?$/, ""))
      .sort();
  }

  function renderList(locale: "en" | "ar", slugs: string[]) {
    const container = document.getElementById(`tab-${locale}`)!;
    if (slugs.length === 0) {
      container.innerHTML = `<p class="text-sm text-ink/50">No posts found.</p>`;
      return;
    }
    container.innerHTML = slugs
      .map(
        (slug) => `
        <a href="/admin/blog-posts/edit/?locale=${locale}&slug=${encodeURIComponent(slug)}"
           class="block rounded-xl border border-sand-light bg-white p-4 text-sm text-ink hover:border-royal hover:text-royal">
          ${slug}
        </a>
      `
      )
      .join("");
  }

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("border-royal", "text-royal");
        b.classList.add("border-transparent", "text-ink/60");
      });
      btn.classList.add("border-royal", "text-royal");
      btn.classList.remove("border-transparent", "text-ink/60");
      document.querySelectorAll(".tab-panel").forEach((p) => p.classList.add("hidden"));
      document.getElementById(`tab-${btn.dataset.tab}`)!.classList.remove("hidden");
    });
  });

  document.getElementById("search")!.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    renderList("en", allPosts.en.filter((s) => s.includes(query)));
    renderList("ar", allPosts.ar.filter((s) => s.includes(query)));
  });

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    const [en, ar] = await Promise.all([fetchPostList("en"), fetchPostList("ar")]);
    allPosts = { en, ar };

    document.getElementById("posts-loading")!.classList.add("hidden");

    if (fetchErrors.length > 0) {
      document.getElementById("posts-loading")!.classList.remove("hidden");
      document.getElementById("posts-loading")!.classList.add("text-red-600");
      document.getElementById("posts-loading")!.textContent = fetchErrors.join(" ");
      return;
    }

    renderList("en", en);
    renderList("ar", ar);
  }

  init();
</script>
