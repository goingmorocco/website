---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Blog Posts | Admin | GoingMorocco"
  description="Manage GoingMorocco blog posts."
  alternateUrls={{ en: "/admin/blog-posts/", ar: "/admin/blog-posts/" }}
>
  <Container class="max-w-3xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <div class="mt-2 flex items-center justify-between">
        <h1 class="font-display text-3xl text-ink">Blog Posts</h1>
        <a href="/admin/write-post/" class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark">
          + New Post
        </a>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <input id="search" type="text" placeholder="Filter by slug or title…"
          class="w-full max-w-sm rounded-lg border border-sand-light px-3 py-2 text-sm" />

        <select id="status-filter" class="rounded-lg border border-sand-light px-3 py-2 text-sm text-ink/70">
          <option value="all">All posts</option>
          <option value="published">Published only</option>
          <option value="draft">Drafts only</option>
        </select>
      </div>

      <div class="mt-6 flex gap-2 border-b border-sand-light">
        <button data-tab="en" class="tab-btn border-b-2 border-royal px-3 py-2 text-sm font-medium text-royal">English</button>
        <button data-tab="ar" class="tab-btn border-b-2 border-transparent px-3 py-2 text-sm font-medium text-ink/60 hover:text-royal">Arabic</button>
      </div>

      <div id="posts-loading" class="mt-4 text-ink/50">Loading posts from GitHub…</div>
      <div id="tab-en" class="tab-panel mt-4 space-y-2"></div>
      <div id="tab-ar" class="tab-panel mt-4 hidden space-y-2"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { requireAdmin } from "../../../utils/adminGuard";
  import { supabase } from "../../../utils/supabaseClient";

  interface PostRow {
    slug: string;
    title: string;
    category: string;
    draft: boolean;
  }

  let allPosts: { en: PostRow[]; ar: PostRow[] } = { en: [], ar: [] };

  async function fetchPostList(): Promise<{ en: PostRow[]; ar: PostRow[] } | null> {
    const { data, error } = await supabase.functions.invoke("list-blog-posts");
    if (error) {
      document.getElementById("posts-loading")!.classList.remove("hidden");
      document.getElementById("posts-loading")!.classList.add("text-red-600");
      document.getElementById("posts-loading")!.textContent = `Couldn't load posts: ${error.message}`;
      return null;
    }
    return data as { en: PostRow[]; ar: PostRow[] };
  }

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function currentStatusFilter(): "all" | "published" | "draft" {
    return (document.getElementById("status-filter") as HTMLSelectElement).value as "all" | "published" | "draft";
  }

  function applyFilters(posts: PostRow[], query: string, status: "all" | "published" | "draft"): PostRow[] {
    return posts.filter((p) => {
      const matchesQuery = !query || p.slug.toLowerCase().includes(query) || p.title.toLowerCase().includes(query);
      const matchesStatus = status === "all" || (status === "draft" ? p.draft : !p.draft);
      return matchesQuery && matchesStatus;
    });
  }

  function renderList(locale: "en" | "ar", posts: PostRow[]) {
    const container = document.getElementById(`tab-${locale}`)!;
    if (posts.length === 0) {
      container.innerHTML = `<p class="text-sm text-ink/50">No posts found.</p>`;
      return;
    }
    container.innerHTML = posts
      .map(
        (post) => `
        <a href="/admin/blog-posts/edit/?locale=${locale}&slug=${encodeURIComponent(post.slug)}"
           class="flex items-center justify-between gap-3 rounded-xl border border-sand-light bg-white p-4 text-sm text-ink hover:border-royal hover:text-royal">
          <span class="min-w-0">
            <span class="block truncate font-medium">${escapeHtml(post.title)}</span>
            <span class="block truncate text-xs text-ink/40">${escapeHtml(post.slug)}${post.category ? ` · ${escapeHtml(post.category)}` : ""}</span>
          </span>
          ${
            post.draft
              ? `<span class="shrink-0 rounded-full bg-sand-light px-2.5 py-1 text-xs font-semibold text-sand-dark">Draft</span>`
              : `<span class="shrink-0 rounded-full bg-royal/10 px-2.5 py-1 text-xs font-semibold text-royal">Published</span>`
          }
        </a>
      `
      )
      .join("");
  }

  function renderAll() {
    const query = (document.getElementById("search") as HTMLInputElement).value.toLowerCase();
    const status = currentStatusFilter();
    renderList("en", applyFilters(allPosts.en, query, status));
    renderList("ar", applyFilters(allPosts.ar, query, status));
  }

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("border-royal", "text-royal");
        b.classList.add("border-transparent", "text-ink/60");
      });
      btn.classList.add("border-royal", "text-royal");
      btn.classList.remove("border-transparent", "text-ink/60");
      document.querySelectorAll(".tab-panel").forEach((p) => p.classList.add("hidden"));
      document.getElementById(`tab-${btn.dataset.tab}`)!.classList.remove("hidden");
    });
  });

  document.getElementById("search")!.addEventListener("input", renderAll);
  document.getElementById("status-filter")!.addEventListener("change", renderAll);

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    const posts = await fetchPostList();
    if (!posts) return;

    allPosts = posts;
    document.getElementById("posts-loading")!.classList.add("hidden");
    renderAll();
  }

  init();
</script>
