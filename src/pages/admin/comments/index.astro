---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Comments | Admin | GoingMorocco"
  description="Moderate GoingMorocco forum comments."
  alternateUrls={{ en: "/admin/comments/", ar: "/admin/comments/" }}
>
  <Container class="max-w-4xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <h1 class="mt-2 font-display text-3xl text-ink">Comments</h1>

      <div id="comments-loading" class="mt-6 text-ink/50">Loading comments…</div>
      <div id="comments-list" class="mt-6 hidden space-y-3"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";
  import { requireAdmin } from "../../../utils/adminGuard";

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  async function loadComments() {
    const { data: comments, error } = await supabase
      .from("forum_comments")
      .select("id, body, image_url, created_at, thread_id, profiles(username, display_name), forum_threads(slug, title)")
      .order("created_at", { ascending: false });

    document.getElementById("comments-loading")!.classList.add("hidden");
    if (error || !comments) return;

    const listEl = document.getElementById("comments-list")!;
    listEl.innerHTML = comments
      .map((c: any) => {
        const author = c.profiles?.display_name || c.profiles?.username || "Someone";
        const date = new Date(c.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        const threadTitle = c.forum_threads?.title ?? "(deleted post)";
        const threadSlug = c.forum_threads?.slug;
        return `
          <div class="rounded-xl border border-sand-light bg-white p-4">
            <div class="flex items-center justify-between">
              <p class="text-sm text-ink/60">${escapeHtml(author)} · ${date} · on
                ${threadSlug ? `<a href="/forum/thread/?slug=${encodeURIComponent(threadSlug)}" class="text-royal hover:underline">${escapeHtml(threadTitle)}</a>` : escapeHtml(threadTitle)}
              </p>
              <button data-delete="${c.id}" class="text-sm text-red-500 hover:underline">Delete</button>
            </div>
            <p class="mt-2 whitespace-pre-wrap text-sm text-ink/80">${escapeHtml(c.body)}</p>
            ${c.image_url ? `<img src="${c.image_url}" alt="" class="mt-2 max-h-40 rounded-lg object-cover" />` : ""}
          </div>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");

    listEl.querySelectorAll<HTMLButtonElement>("[data-delete]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Delete this comment?")) return;
        const { error: deleteError } = await supabase.from("forum_comments").delete().eq("id", btn.dataset.delete!);
        if (deleteError) {
          alert(`Couldn't delete: ${deleteError.message}`);
          return;
        }
        loadComments();
      });
    });
  }

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    loadComments();
  }

  init();
</script>
