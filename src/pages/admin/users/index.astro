---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Users | Admin | GoingMorocco"
  description="Manage GoingMorocco members."
  alternateUrls={{ en: "/admin/users/", ar: "/admin/users/" }}
>
  <Container class="max-w-4xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <h1 class="mt-2 font-display text-3xl text-ink">Users</h1>

      <input id="search" type="text" placeholder="Search by username…"
        class="mt-4 w-full max-w-sm rounded-lg border border-sand-light px-3 py-2 text-sm" />

      <div id="users-loading" class="mt-6 text-ink/50">Loading users…</div>
      <div id="users-table-wrap" class="mt-6 hidden overflow-hidden rounded-xl border border-sand-light bg-white">
        <table class="w-full text-sm">
          <thead class="bg-sand-light/40 text-left text-ink/70">
            <tr>
              <th class="px-4 py-3 font-medium">Username</th>
              <th class="px-4 py-3 font-medium">Role</th>
              <th class="px-4 py-3 font-medium">Joined</th>
              <th class="px-4 py-3 font-medium"></th>
            </tr>
          </thead>
          <tbody id="users-tbody"></tbody>
        </table>
      </div>
    </div>
  </Container>
</BaseLayout>

<!-- Notify modal -->
<div id="notify-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/40 p-4">
  <div class="w-full max-w-md rounded-xl bg-white p-6">
    <h2 class="font-semibold text-lg text-ink">Send notification to <span id="notify-target-name"></span></h2>
    <input id="notify-title" type="text" placeholder="Title" maxlength="100"
      class="mt-3 w-full rounded-lg border border-sand-light px-3 py-2 text-sm" />
    <textarea id="notify-body" placeholder="Message (optional)" rows="3"
      class="mt-2 w-full rounded-lg border border-sand-light px-3 py-2 text-sm"></textarea>
    <p id="notify-error" class="mt-1 hidden text-sm text-red-600"></p>
    <div class="mt-3 flex justify-end gap-2">
      <button id="notify-cancel" class="rounded-full px-4 py-2 text-sm text-ink/60">Cancel</button>
      <button id="notify-send" class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white">Send</button>
    </div>
  </div>
</div>

<script>
  import { supabase } from "../../../utils/supabaseClient";
  import { requireAdmin } from "../../../utils/adminGuard";

  let allUsers: any[] = [];
  let notifyTargetId: string | null = null;

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  function renderUsers(users: any[]) {
    const tbody = document.getElementById("users-tbody")!;
    tbody.innerHTML = users
      .map((u) => {
        const date = new Date(u.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        return `
          <tr class="border-t border-sand-light">
            <td class="px-4 py-3">
              <a href="/account/profile/?u=${encodeURIComponent(u.username)}" class="font-medium text-ink hover:text-royal">${escapeHtml(u.display_name || u.username)}</a>
              <p class="text-xs text-ink/50">@${escapeHtml(u.username)}</p>
            </td>
            <td class="px-4 py-3 text-ink/60">${u.role}</td>
            <td class="px-4 py-3 text-ink/60">${date}</td>
            <td class="px-4 py-3 text-right">
              <button data-notify="${u.id}" data-name="${escapeHtml(u.display_name || u.username)}" class="mr-3 text-royal hover:underline">Notify</button>
              <a href="/admin/messages/?with=${u.id}" class="text-royal hover:underline">Message</a>
            </td>
          </tr>
        `;
      })
      .join("");

    tbody.querySelectorAll<HTMLButtonElement>("[data-notify]").forEach((btn) => {
      btn.addEventListener("click", () => openNotifyModal(btn.dataset.notify!, btn.dataset.name!));
    });
  }

  function openNotifyModal(userId: string, name: string) {
    notifyTargetId = userId;
    document.getElementById("notify-target-name")!.textContent = name;
    document.getElementById("notify-modal")!.classList.remove("hidden");
    document.getElementById("notify-modal")!.classList.add("flex");
  }

  document.getElementById("notify-cancel")!.addEventListener("click", () => {
    document.getElementById("notify-modal")!.classList.add("hidden");
  });

  document.getElementById("notify-send")!.addEventListener("click", async () => {
    const errorEl = document.getElementById("notify-error")!;
    errorEl.classList.add("hidden");

    const title = (document.getElementById("notify-title") as HTMLInputElement).value.trim();
    const body = (document.getElementById("notify-body") as HTMLTextAreaElement).value.trim();

    if (!title || !notifyTargetId) {
      errorEl.textContent = "Add a title first.";
      errorEl.classList.remove("hidden");
      return;
    }

    const { error } = await supabase.from("notifications").insert({
      user_id: notifyTargetId,
      title,
      body: body || null,
    });

    if (error) {
      errorEl.textContent = error.message;
      errorEl.classList.remove("hidden");
      return;
    }

    document.getElementById("notify-modal")!.classList.add("hidden");
    (document.getElementById("notify-title") as HTMLInputElement).value = "";
    (document.getElementById("notify-body") as HTMLTextAreaElement).value = "";
  });

  document.getElementById("search")!.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    const filtered = allUsers.filter((u) => u.username.toLowerCase().includes(query) || (u.display_name ?? "").toLowerCase().includes(query));
    renderUsers(filtered);
  });

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    const { data, error } = await supabase
      .from("profiles")
      .select("id, username, display_name, role, created_at")
      .order("created_at", { ascending: false });

    document.getElementById("users-loading")!.classList.add("hidden");

    if (error || !data) return;

    allUsers = data;
    renderUsers(allUsers);
    document.getElementById("users-table-wrap")!.classList.remove("hidden");
  }

  init();
</script>
