---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Admin | GoingMorocco"
  description="Admin dashboard."
  alternateUrls={{ en: "/admin/", ar: "/admin/" }}
>
  <Container class="max-w-4xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <h1 class="font-display text-3xl text-ink">Admin</h1>

      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="rounded-xl border border-sand-light bg-white p-4 text-center">
          <p id="stat-users" class="font-display text-2xl text-ink">—</p>
          <p class="text-xs text-ink/50">Members</p>
        </div>
        <div class="rounded-xl border border-sand-light bg-white p-4 text-center">
          <p id="stat-posts" class="font-display text-2xl text-ink">—</p>
          <p class="text-xs text-ink/50">Forum Posts</p>
        </div>
        <div class="rounded-xl border border-sand-light bg-white p-4 text-center">
          <p id="stat-comments" class="font-display text-2xl text-ink">—</p>
          <p class="text-xs text-ink/50">Comments</p>
        </div>
        <div class="rounded-xl border border-sand-light bg-white p-4 text-center">
          <p id="stat-unread-messages" class="font-display text-2xl text-ink">—</p>
          <p class="text-xs text-ink/50">Unread Messages to You</p>
        </div>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <a href="/admin/users/" class="rounded-2xl border border-sand-light bg-white p-6 shadow-sm hover:shadow-md">
          <h2 class="font-display text-lg text-ink">Users</h2>
          <p class="mt-1 text-sm text-ink/60">Browse members, send notifications, message someone directly.</p>
        </a>
        <a href="/admin/posts/" class="rounded-2xl border border-sand-light bg-white p-6 shadow-sm hover:shadow-md">
          <h2 class="font-display text-lg text-ink">Forum Posts</h2>
          <p class="mt-1 text-sm text-ink/60">Every post across all categories, with moderation.</p>
        </a>
        <a href="/admin/comments/" class="rounded-2xl border border-sand-light bg-white p-6 shadow-sm hover:shadow-md">
          <h2 class="font-display text-lg text-ink">Comments</h2>
          <p class="mt-1 text-sm text-ink/60">Every comment site-wide, with moderation.</p>
        </a>
        <a href="/admin/messages/" class="rounded-2xl border border-sand-light bg-white p-6 shadow-sm hover:shadow-md">
          <h2 class="font-display text-lg text-ink">Messages</h2>
          <p class="mt-1 text-sm text-ink/60">Your conversations with members.</p>
        </a>
      </div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../utils/supabaseClient";
  import { requireAdmin } from "../../utils/adminGuard";

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    const [{ count: userCount }, { count: postCount }, { count: commentCount }, { count: unreadCount }] = await Promise.all([
      supabase.from("profiles").select("*", { count: "exact", head: true }),
      supabase.from("forum_threads").select("*", { count: "exact", head: true }),
      supabase.from("forum_comments").select("*", { count: "exact", head: true }),
      supabase.from("messages").select("*", { count: "exact", head: true }).eq("recipient_id", admin.userId).eq("is_read", false),
    ]);

    document.getElementById("stat-users")!.textContent = String(userCount ?? 0);
    document.getElementById("stat-posts")!.textContent = String(postCount ?? 0);
    document.getElementById("stat-comments")!.textContent = String(commentCount ?? 0);
    document.getElementById("stat-unread-messages")!.textContent = String(unreadCount ?? 0);
  }

  init();
</script>
