---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Reports | Admin | GoingMorocco"
  description="Moderate reported forum content."
  alternateUrls={{ en: "/admin/reports/", ar: "/admin/reports/" }}
>
  <Container class="max-w-3xl py-16">
    <div id="checking" class="text-center text-ink/50">Checking access…</div>

    <div id="admin-content" class="hidden">
      <a href="/account/dashboard/" class="text-sm text-royal hover:underline">← Dashboard</a>
      <h1 class="mt-2 font-display text-3xl text-ink">Reports</h1>

      <div id="reports-loading" class="mt-6 text-ink/50">Loading reports…</div>
      <div id="reports-empty" class="mt-6 hidden text-ink/50">No open reports. All clear.</div>
      <div id="reports-list" class="mt-6 hidden space-y-4"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";
  import { requireAdmin } from "../../../utils/adminGuard";

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  async function loadReports() {
    const { data: reports, error } = await supabase
      .from("reports")
      .select("id, reason, status, created_at, thread_id, comment_id, profiles(username, display_name), forum_threads(slug, title), forum_comments(body, thread_id)")
      .eq("status", "open")
      .order("created_at", { ascending: false });

    document.getElementById("reports-loading")!.classList.add("hidden");

    if (error || !reports || reports.length === 0) {
      document.getElementById("reports-empty")!.classList.remove("hidden");
      return;
    }

    const listEl = document.getElementById("reports-list")!;
    listEl.innerHTML = reports
      .map((r: any) => {
        const reporter = r.profiles?.display_name || r.profiles?.username || "Someone";
        const date = new Date(r.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        const isThread = !!r.thread_id;
        const contentPreview = isThread
          ? `Post: <a href="/forum/thread/?slug=${encodeURIComponent(r.forum_threads?.slug ?? "")}" class="text-royal hover:underline">${escapeHtml(r.forum_threads?.title ?? "(deleted)")}</a>`
          : `Comment: "${escapeHtml((r.forum_comments?.body ?? "(deleted)").slice(0, 100))}"`;

        return `
          <div class="rounded-xl border border-sand-light bg-white p-4">
            <p class="text-sm text-ink/50">Reported by ${escapeHtml(reporter)} · ${date}</p>
            <p class="mt-1 text-sm">${contentPreview}</p>
            <p class="mt-2 rounded-lg bg-sand-light/40 p-2 text-sm text-ink/80">"${escapeHtml(r.reason)}"</p>
            <div class="mt-3 flex gap-3">
              <button data-delete-content data-report-id="${r.id}" data-thread-id="${r.thread_id ?? ""}" data-comment-id="${r.comment_id ?? ""}" class="text-sm text-red-500 hover:underline">
                Delete ${isThread ? "Post" : "Comment"}
              </button>
              <button data-dismiss="${r.id}" class="text-sm text-ink/50 hover:underline">Dismiss Report</button>
            </div>
          </div>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");

    listEl.querySelectorAll<HTMLButtonElement>("[data-dismiss]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        await supabase.from("reports").update({ status: "dismissed" }).eq("id", btn.dataset.dismiss!);
        loadReports();
      });
    });

    listEl.querySelectorAll<HTMLButtonElement>("[data-delete-content]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Delete the reported content? This can't be undone.")) return;

        if (btn.dataset.threadId) {
          await supabase.from("forum_threads").delete().eq("id", btn.dataset.threadId);
        } else if (btn.dataset.commentId) {
          await supabase.from("forum_comments").delete().eq("id", btn.dataset.commentId);
        }

        await supabase.from("reports").update({ status: "resolved" }).eq("id", btn.dataset.reportId!);
        loadReports();
      });
    });
  }

  async function init() {
    const admin = await requireAdmin();
    if (!admin) return;

    document.getElementById("checking")!.classList.add("hidden");
    document.getElementById("admin-content")!.classList.remove("hidden");

    loadReports();
  }

  init();
</script>
