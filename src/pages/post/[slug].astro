---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import { wixResizedUrl } from "../../utils/wixImage";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import PostNav from "../../components/PostNav.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { t, formatDate, localizedPath } from "../../utils/i18n";
import { sortByDateDesc, getAdjacentPosts, getRelatedPosts } from "../../utils/posts";
import { getReadingTime } from "../../utils/reading-time";
import { buildBlogPostingSchema, buildBreadcrumbSchema, type BreadcrumbItem } from "../../utils/seo";

const locale = "en" as const;
const strings = t(locale);

export const getStaticPaths = (async () => {
  const posts = await getCollection("blog", (p) => p.data.locale === "en" && !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as Awaited<ReturnType<typeof getStaticPaths>>[number]["props"];
const { Content, headings } = await render(post);

const allPosts = await getCollection("blog", (p) => p.data.locale === "en" && !p.data.draft);
const categories = await getCollection("categories", (c) => c.data.locale === locale);
const categoryEntry = categories.find((c) => c.data.id === post.data.category);

const sorted = sortByDateDesc(allPosts);
const { previous, next } = getAdjacentPosts(sorted, post.data.slug);
const related = getRelatedPosts(allPosts, post, 3);
const categoryName = (id: string) => categories.find((c) => c.data.id === id)?.data.name;

const readingTime = post.data.readingTimeMinutes ?? getReadingTime(post.body ?? "", locale);

const postUrl = localizedPath("en", `/post/${post.data.slug}/`);

// OG image export via getImage() only works for local files processed by
// astro:assets. Migrated posts with a remote (Wix-hosted) featuredImage use
// that URL directly for OG/Twitter instead -- it's already close to a
// 1200-wide image in most cases, just not re-cropped to an exact 1200x630.
const isRemoteImage = typeof post.data.featuredImage === "string";
const ogImageSrc = isRemoteImage
  ? wixResizedUrl(post.data.featuredImage as string, 1200, 630, 80)
  : (await getImage({ src: post.data.featuredImage as ImageMetadata, width: 1200, height: 630 })).src;

const breadcrumbItems: BreadcrumbItem[] = [
  { label: strings.nav.home, href: "/" },
  { label: strings.nav.blog, href: "/post/" },
  ...(categoryEntry ? [{ label: categoryEntry.data.name, href: `/categories/${categoryEntry.data.id}/` }] : []),
  { label: post.data.title },
];

const structuredData = [
  buildBlogPostingSchema({
    title: post.data.title,
    description: post.data.description,
    imageUrl: ogImageSrc,
    publishDate: post.data.publishDate,
    updatedDate: post.data.updatedDate,
    author: post.data.author,
    url: postUrl,
    locale,
  }),
  buildBreadcrumbSchema(breadcrumbItems),
];
---

<BaseLayout
  locale={locale}
  title={`${post.data.title} — GoingMorocco`}
  description={post.data.description}
  alternateUrls={{ en: postUrl }}
  image={ogImageSrc}
  ogType="article"
  structuredData={structuredData}
>
  <Container class="py-8">
    <Breadcrumbs items={breadcrumbItems} />
  </Container>

  <!--
    FIX (mobile overflow / "desktop mode" bug): the grid-template-columns
    below was previously only declared at the `lg:` breakpoint
    (`lg:grid-cols-[minmax(0,1fr)_280px]`), which meant that on mobile this
    grid had NO explicit column track at all. An implicit/auto grid track
    has no enforced minimum-width of 0 -- it happily grows to fit its
    largest child's intrinsic content size. A post using <Gallery> with a
    2560px-wide source image (or any other oversized element) would force
    that implicit column -- and with it the whole page -- wider than the
    device viewport. Mobile browsers respond to that by rendering the page
    at its full (wider) layout width and shrinking it to fit the screen,
    which is exactly the "zoomed out / desktop mode" symptom reported.

    `grid-cols-1` makes Tailwind emit `grid-template-columns: repeat(1,
    minmax(0, 1fr))` at the base breakpoint, which -- like the `lg:` rule
    already did for desktop -- gives the column a real 0 minimum, so it can
    never grow past its container no matter how wide its content wants to
    be.
  -->
  <Container class="grid grid-cols-1 gap-10 overflow-x-hidden pb-16 lg:grid-cols-[minmax(0,1fr)_280px]">
    <!--
      Second layer of defense: `min-w-0` on the grid item itself.
      Flex/grid children default to `min-width: auto`, which (independent of
      the parent track's own minmax) lets a child's oversized intrinsic
      content push it wider than its track. `min-w-0` here removes that
      loophole so `<article>` can never be wider than the column it lives in,
      whatever a future component ends up embedding.
    -->
    <article class="min-w-0 overflow-x-hidden">
      <header class="mb-6">
        {categoryEntry && (
          <a href={`/categories/${categoryEntry.data.id}/`} class="text-xs font-semibold uppercase tracking-wide text-gold-text">
            {categoryEntry.data.name}
          </a>
        )}
        <h1 class="mt-2 font-display text-3xl leading-tight text-ink sm:text-4xl">{post.data.title}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-ink/60">
          <span>{post.data.author}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.publishDate.toISOString()}>
            {strings.blog.publishedOn} {formatDate(post.data.publishDate, locale)}
          </time>
          {post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                {strings.blog.updatedOn} {formatDate(post.data.updatedDate, locale)}
              </time>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{strings.blog.readingTime(readingTime)}</span>
        </div>
      </header>

      {isRemoteImage ? (
        <img
          src={wixResizedUrl(post.data.featuredImage as string, 1600, 1067, 80)}
          alt={post.data.featuredImageAlt}
          width="1200"
          height="800"
          class="w-full max-w-full rounded-2xl object-cover"
          loading="eager"
          decoding="async"
        />
      ) : (
        <Image
          src={post.data.featuredImage as ImageMetadata}
          alt={post.data.featuredImageAlt}
          width={1200}
          height={800}
          class="w-full max-w-full rounded-2xl object-cover"
          priority
        />
      )}

      <!--
        Third layer: min-w-0 again on the direct prose wrapper, plus
        overflow-x-hidden as a hard clip of last resort. Anything a content
        component does internally (Gallery's own grid, a raw HTML table,
        a future embed) is now guaranteed to be clipped here rather than
        propagating up into the page.
      -->
      <div class="prose-content mt-8 min-w-0 max-w-none overflow-x-hidden">
        <Content />
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="rounded-full bg-sand-light px-3 py-1 text-xs text-ink/70">#{tag}</span>
        ))}
      </div>

      <div class="mt-10">
        <PostNav locale={locale} previous={previous} next={next} />
      </div>
    </article>

    <aside class="lg:sticky lg:top-20 lg:self-start">
      <TableOfContents headings={headings} locale={locale} />
    </aside>
  </Container>

  <Container class="pb-16">
    <RelatedPosts locale={locale} posts={related} categoryName={categoryName} />
  </Container>
</BaseLayout>
