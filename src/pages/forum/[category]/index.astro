---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";

// The 4 categories are fixed and known in advance (seeded once in
// supabase-schema.sql), so unlike threads/profiles these CAN be real static
// routes — better for SEO than the query-param shell pattern used for
// user-generated content. If you ever add a 5th category in Supabase,
// add its slug + names here too, or this list will silently miss it.
const categories = [
  { slug: "my-experience", nameEn: "My Experience in Morocco", nameAr: "تجربتي في المغرب" },
  { slug: "hotels", nameEn: "Hotels in Morocco", nameAr: "الفنادق في المغرب" },
  { slug: "reviews", nameEn: "Reviews & Recommendations", nameAr: "التقييمات والتوصيات" },
  { slug: "services", nameEn: "Other Travel Services", nameAr: "خدمات سفر أخرى" },
];

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props;
---

<BaseLayout
  locale="en"
  title={`${cat.nameEn} | GoingMorocco Forum`}
  description={`${cat.nameEn} — read and share posts in this category.`}
  alternateUrls={{ en: `/forum/${cat.slug}/`, ar: `/ar/forum/${cat.slug}/` }}
>
  <Container class="max-w-3xl py-16" data-category-slug={cat.slug}>
    <a href="/forum/" class="text-sm text-royal hover:underline">← All Categories</a>
    <div class="mt-3 flex items-center justify-between">
      <h1 class="font-display text-3xl text-ink">{cat.nameEn}</h1>
      <a
        href={`/account/dashboard/new-thread/?category=${cat.slug}`}
        class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark"
      >
        + New Post
      </a>
    </div>

    <div id="threads-loading" class="mt-8 text-ink/50">Loading posts…</div>
    <div id="threads-empty" class="mt-8 hidden text-ink/50">No posts here yet — be the first to share something.</div>
    <div id="threads-list" class="mt-8 hidden space-y-4"></div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";

  const loadingEl = document.getElementById("threads-loading")!;
  const emptyEl = document.getElementById("threads-empty")!;
  const listEl = document.getElementById("threads-list")!;
  const categorySlug = document.querySelector<HTMLElement>("[data-category-slug]")!.dataset.categorySlug!;

  async function loadThreads() {
    const { data: category } = await supabase
      .from("forum_categories")
      .select("id")
      .eq("slug", categorySlug)
      .single();

    if (!category) {
      loadingEl.textContent = "Category not found.";
      return;
    }

    const { data: threads, error } = await supabase
      .from("forum_threads")
      .select("slug, title, created_at, profiles(username, display_name)")
      .eq("category_id", category.id)
      .order("created_at", { ascending: false });

    loadingEl.classList.add("hidden");

    if (error || !threads || threads.length === 0) {
      emptyEl.classList.remove("hidden");
      return;
    }

    listEl.innerHTML = threads
      .map((t: any) => {
        const author = t.profiles?.display_name || t.profiles?.username || "Someone";
        const date = new Date(t.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        return `
          <a href="/forum/thread/?slug=${encodeURIComponent(t.slug)}" class="block rounded-xl border border-sand-light bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
            <h2 class="font-display text-lg text-ink">${t.title}</h2>
            <p class="mt-1 text-sm text-ink/50">by ${author} · ${date}</p>
          </a>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");
  }

  loadThreads();
</script>
