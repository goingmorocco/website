---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";

export async function getStaticPaths() {
  const posts = await getCollection("forumPosts");
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  locale="en"
  title={`${post.data.title} | GoingMorocco Forum`}
  description={post.data.description}
  alternateUrls={{ en: `/forum/post/${post.data.slug}/`, ar: `/forum/post/${post.data.slug}/` }}
>
  <Container class="max-w-2xl py-16">
    <a href={`/forum/${post.data.category}/`} class="text-sm text-royal hover:underline">← {post.data.category}</a>

    {post.data.featuredImage && (
      <img src={post.data.featuredImage} alt="" class="mt-3 h-56 w-full rounded-2xl object-cover" />
    )}

    <h1 class="mt-3 font-display text-3xl text-ink">{post.data.title}</h1>
    <p class="mt-2 text-sm text-ink/50">
      by {post.data.author} · {post.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
    </p>

    <div class="prose-content mt-6">
      <Content />
    </div>

    <!-- Like -->
    <div class="mt-6 flex items-center gap-3">
      <button id="like-btn" class="inline-flex items-center gap-2 rounded-full border border-sand-light px-4 py-2 text-sm font-medium text-ink/70 hover:border-royal">
        <span id="like-icon">🤍</span>
        <span id="like-count">0</span> likes
      </button>
    </div>

    <!-- Share -->
    <div class="mt-6 flex flex-wrap items-center gap-2 border-y border-sand-light py-4">
      <span class="text-sm font-medium text-ink/60">Share:</span>
      <button data-share="whatsapp" class="rounded-full bg-[#25D366] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90">WhatsApp</button>
      <button data-share="facebook" class="rounded-full bg-[#1877F2] px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90">Facebook</button>
      <button data-share="x" class="rounded-full bg-black px-3 py-1.5 text-sm font-semibold text-white hover:opacity-90">X</button>
      <button data-share="copy" class="rounded-full border border-sand-light px-3 py-1.5 text-sm font-semibold text-ink/70 hover:border-royal hover:text-royal">🔗 Copy Link</button>
    </div>

    <!-- Comments -->
    <div class="mt-10" data-thread-id={post.data.threadId}>
      <h2 class="font-display text-xl text-ink">Comments</h2>

      <div id="comment-form-wrap" class="mt-4 hidden">
        <textarea id="comment-body" rows="3" placeholder="Share your experience or ask a question…"
          class="w-full rounded-lg border border-sand-light px-3 py-2 focus:border-royal focus:outline-none"></textarea>
        <div class="mt-2 flex items-center justify-between">
          <label class="inline-flex cursor-pointer items-center gap-1 text-sm text-ink/60 hover:text-royal">
            🖼 Add a photo
            <input id="comment-image-input" type="file" accept="image/*" class="hidden" />
          </label>
          <button id="comment-submit" class="rounded-full bg-royal px-5 py-2 text-sm font-semibold text-white hover:bg-royal-dark">
            Post Comment
          </button>
        </div>
        <div id="comment-image-preview-wrap" class="mt-2 hidden">
          <img id="comment-image-preview" class="h-24 rounded-lg object-cover" alt="" />
          <button id="comment-image-remove" type="button" class="ml-2 text-xs text-red-500 hover:underline">Remove</button>
        </div>
        <p id="comment-error" class="mt-1 hidden text-sm text-red-600"></p>
      </div>

      <p id="comment-login-prompt" class="mt-4 hidden text-sm text-ink/60">
        <a href="/account/login/" class="text-royal hover:underline">Log in</a> to leave a comment.
      </p>

      <div id="comments-loading" class="mt-6 text-sm text-ink/50">Loading comments…</div>
      <div id="comments-empty" class="mt-6 hidden text-sm text-ink/50">No comments yet — be the first to respond.</div>
      <div id="comments-list" class="mt-6 hidden space-y-4"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";

  const threadId = document.querySelector<HTMLElement>("[data-thread-id]")!.dataset.threadId!;
  let currentUserId: string | null = null;
  let pendingCommentImageUrl: string | null = null;

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  // ---------- Like ----------
  async function setupLikeButton() {
    const { data: sessionData } = await supabase.auth.getSession();
    currentUserId = sessionData.session?.user.id ?? null;
    await refreshLikeState();

    document.getElementById("like-btn")!.addEventListener("click", async () => {
      if (!currentUserId) {
        window.location.href = "/account/login/";
        return;
      }
      const { data: existing } = await supabase
        .from("forum_reactions")
        .select("id")
        .eq("thread_id", threadId)
        .eq("user_id", currentUserId)
        .maybeSingle();

      if (existing) {
        await supabase.from("forum_reactions").delete().eq("id", existing.id);
      } else {
        await supabase.from("forum_reactions").insert({ thread_id: threadId, user_id: currentUserId });
      }
      refreshLikeState();
    });
  }

  async function refreshLikeState() {
    const { count } = await supabase.from("forum_reactions").select("*", { count: "exact", head: true }).eq("thread_id", threadId);
    document.getElementById("like-count")!.textContent = String(count ?? 0);

    if (currentUserId) {
      const { data: existing } = await supabase
        .from("forum_reactions")
        .select("id")
        .eq("thread_id", threadId)
        .eq("user_id", currentUserId)
        .maybeSingle();
      document.getElementById("like-icon")!.textContent = existing ? "❤️" : "🤍";
    }
  }

  // ---------- Share ----------
  document.querySelectorAll<HTMLButtonElement>("[data-share]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = window.location.href;
      const text = `${document.title}`;
      const platform = btn.dataset.share;
      if (platform === "whatsapp") window.open(`https://wa.me/?text=${encodeURIComponent(text + " " + url)}`, "_blank");
      else if (platform === "facebook") window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, "_blank");
      else if (platform === "x") window.open(`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(text)}`, "_blank");
      else if (platform === "copy") {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = "✓ Copied!";
        setTimeout(() => (btn.textContent = original), 1800);
      }
    });
  });

  // ---------- Comments ----------
  async function loadComments() {
    const { data: comments, error } = await supabase
      .from("forum_comments")
      .select("id, body, image_url, created_at, author_id, profiles(username, display_name)")
      .eq("thread_id", threadId)
      .order("created_at", { ascending: true });

    document.getElementById("comments-loading")!.classList.add("hidden");

    if (error || !comments || comments.length === 0) {
      document.getElementById("comments-empty")!.classList.remove("hidden");
      return;
    }

    const listEl = document.getElementById("comments-list")!;
    listEl.innerHTML = comments
      .map((c: any) => {
        const author = c.profiles?.display_name || c.profiles?.username || "Someone";
        const date = new Date(c.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
        const canDelete = currentUserId && c.author_id === currentUserId;
        return `
          <div class="rounded-xl border border-sand-light bg-white p-4">
            <div class="flex items-center justify-between">
              <p class="text-sm font-medium text-ink">${escapeHtml(author)} <span class="font-normal text-ink/40">· ${date}</span></p>
              ${canDelete ? `<button data-delete-comment="${c.id}" class="text-xs text-red-500 hover:underline">Delete</button>` : ""}
            </div>
            <p class="mt-2 whitespace-pre-wrap text-sm text-ink/80">${escapeHtml(c.body)}</p>
            ${c.image_url ? `<img src="${c.image_url}" alt="" class="mt-3 max-h-64 rounded-lg object-cover" />` : ""}
          </div>
        `;
      })
      .join("");
    listEl.classList.remove("hidden");

    listEl.querySelectorAll<HTMLButtonElement>("[data-delete-comment]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!confirm("Delete this comment?")) return;
        await supabase.from("forum_comments").delete().eq("id", btn.dataset.deleteComment!);
        loadComments();
      });
    });
  }

  document.getElementById("comment-image-input")!.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    if (file.size > 3 * 1024 * 1024) {
      alert("Comment photos are limited to 3 MB.");
      return;
    }
    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) return;
    const path = `${sessionData.session.user.id}/comment-${Date.now()}-${file.name.replace(/[^a-zA-Z0-9._-]/g, "-")}`;
    const { error } = await supabase.storage.from("forum-media").upload(path, file);
    if (error) { alert(`Upload failed: ${error.message}`); return; }
    const { data: publicUrlData } = supabase.storage.from("forum-media").getPublicUrl(path);
    pendingCommentImageUrl = publicUrlData.publicUrl;
    (document.getElementById("comment-image-preview") as HTMLImageElement).src = pendingCommentImageUrl;
    document.getElementById("comment-image-preview-wrap")!.classList.remove("hidden");
  });

  document.getElementById("comment-image-remove")!.addEventListener("click", () => {
    pendingCommentImageUrl = null;
    document.getElementById("comment-image-preview-wrap")!.classList.add("hidden");
    (document.getElementById("comment-image-input") as HTMLInputElement).value = "";
  });

  document.getElementById("comment-submit")!.addEventListener("click", async () => {
    const errorEl = document.getElementById("comment-error")!;
    errorEl.classList.add("hidden");
    const bodyInput = document.getElementById("comment-body") as HTMLTextAreaElement;
    const body = bodyInput.value.trim();
    if (!body) { errorEl.textContent = "Write something before posting."; errorEl.classList.remove("hidden"); return; }

    const { data: sessionData } = await supabase.auth.getSession();
    if (!sessionData.session) { window.location.href = "/account/login/"; return; }

    const { error } = await supabase.from("forum_comments").insert({
      thread_id: threadId,
      author_id: sessionData.session.user.id,
      body,
      image_url: pendingCommentImageUrl,
    });

    if (error) { errorEl.textContent = error.message; errorEl.classList.remove("hidden"); return; }

    bodyInput.value = "";
    pendingCommentImageUrl = null;
    document.getElementById("comment-image-preview-wrap")!.classList.add("hidden");
    loadComments();
  });

  async function setupCommentForm() {
    const { data } = await supabase.auth.getSession();
    if (data.session) {
      document.getElementById("comment-form-wrap")!.classList.remove("hidden");
    } else {
      document.getElementById("comment-login-prompt")!.classList.remove("hidden");
    }
  }

  setupLikeButton();
  setupCommentForm();
  loadComments();
</script>
