---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
---

<BaseLayout
  locale="en"
  title="Member Profile | GoingMorocco"
  description="View a GoingMorocco member's profile."
  alternateUrls={{ en: "/account/profile/", ar: "/ar/account/profile/" }}
>
  <Container class="max-w-2xl py-16">
    <div id="profile-loading" class="text-center text-ink/50">Loading profile…</div>

    <div id="profile-not-found" class="hidden text-center">
      <p class="text-ink/70">This member couldn't be found.</p>
      <a href="/" class="mt-2 inline-block text-royal hover:underline">Back to homepage</a>
    </div>

    <div id="profile-content" class="hidden">
      <div class="flex items-center gap-4">
        <img id="profile-avatar" src="/logo.png" alt="" class="h-20 w-20 rounded-full border border-sand-light object-cover" />
        <div>
          <h1 id="profile-display-name" class="font-display text-2xl text-ink"></h1>
          <p class="text-ink/60">@<span id="profile-username"></span></p>
          <span id="profile-badge" class="hidden mt-1 inline-block rounded-full bg-sand-light px-2 py-0.5 text-xs font-medium text-ink/70">Business</span>
        </div>
      </div>
      <p id="profile-bio" class="mt-6 text-ink/80"></p>
      <p id="profile-joined" class="mt-4 text-sm text-ink/50"></p>
      <a id="profile-edit-link" href="/account/settings/" class="mt-4 hidden inline-block rounded-full border border-royal px-4 py-1.5 text-sm font-semibold text-royal hover:bg-royal hover:text-white">
        Edit Profile
      </a>

      <div class="mt-8 flex gap-2 border-b border-sand-light">
        <button data-tab="posts" class="tab-btn border-b-2 border-royal px-3 py-2 text-sm font-medium text-royal">Posts</button>
        <button data-tab="comments" class="tab-btn border-b-2 border-transparent px-3 py-2 text-sm font-medium text-ink/60 hover:text-royal">Comments</button>
        <button data-tab="likes" class="tab-btn border-b-2 border-transparent px-3 py-2 text-sm font-medium text-ink/60 hover:text-royal">Liked Posts</button>
      </div>

      <div id="tab-posts" class="tab-panel mt-4 space-y-3"></div>
      <div id="tab-comments" class="tab-panel mt-4 hidden space-y-3"></div>
      <div id="tab-likes" class="tab-panel mt-4 hidden space-y-3"></div>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";

  const params = new URLSearchParams(window.location.search);
  const username = params.get("u");

  const loadingEl = document.getElementById("profile-loading")!;
  const notFoundEl = document.getElementById("profile-not-found")!;
  const contentEl = document.getElementById("profile-content")!;

  async function loadProfile() {
    if (!username) {
      loadingEl.classList.add("hidden");
      notFoundEl.classList.remove("hidden");
      return;
    }

    const { data, error } = await supabase
      .from("profiles")
      .select("id, username, display_name, avatar_url, bio, role, created_at")
      .eq("username", username)
      .single();

    loadingEl.classList.add("hidden");

    if (error || !data) {
      notFoundEl.classList.remove("hidden");
      return;
    }

    document.getElementById("profile-display-name")!.textContent = data.display_name || data.username;
    document.getElementById("profile-username")!.textContent = data.username;
    document.getElementById("profile-bio")!.textContent = data.bio || "";
    document.getElementById("profile-joined")!.textContent =
      "Member since " + new Date(data.created_at).toLocaleDateString("en-US", { year: "numeric", month: "long" });

    if (data.avatar_url) {
      (document.getElementById("profile-avatar") as HTMLImageElement).src = data.avatar_url;
    }
    if (data.role === "business") {
      document.getElementById("profile-badge")!.classList.remove("hidden");
    }

    contentEl.classList.remove("hidden");

    // Show "Edit Profile" only when viewing your own profile.
    const { data: sessionData } = await supabase.auth.getSession();
    if (sessionData.session?.user.id === data.id) {
      document.getElementById("profile-edit-link")!.classList.remove("hidden");
    }

    loadActivity(data.id);
  }

  function escapeHtml(text: string): string {
    return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  async function loadActivity(profileId: string) {
    const [{ data: posts }, { data: comments }, { data: likes }] = await Promise.all([
      supabase
        .from("forum_threads")
        .select("slug, title, created_at")
        .eq("author_id", profileId)
        .order("created_at", { ascending: false }),
      supabase
        .from("forum_comments")
        .select("body, created_at, forum_threads(slug, title)")
        .eq("author_id", profileId)
        .order("created_at", { ascending: false }),
      supabase
        .from("forum_reactions")
        .select("created_at, forum_threads(slug, title)")
        .eq("user_id", profileId)
        .not("thread_id", "is", null)
        .order("created_at", { ascending: false }),
    ]);

    const postsEl = document.getElementById("tab-posts")!;
    postsEl.innerHTML = posts && posts.length
      ? posts.map((p: any) => `
          <a href="/forum/thread/?slug=${encodeURIComponent(p.slug)}" class="block rounded-xl border border-sand-light bg-white p-4 hover:border-royal">
            <p class="font-medium text-ink">${escapeHtml(p.title)}</p>
            <p class="mt-0.5 text-xs text-ink/50">${new Date(p.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</p>
          </a>
        `).join("")
      : `<p class="text-sm text-ink/50">No posts yet.</p>`;

    const commentsEl = document.getElementById("tab-comments")!;
    commentsEl.innerHTML = comments && comments.length
      ? comments.map((c: any) => `
          <div class="rounded-xl border border-sand-light bg-white p-4">
            <p class="text-sm text-ink/80">${escapeHtml(c.body)}</p>
            <p class="mt-1 text-xs text-ink/50">
              on ${c.forum_threads ? `<a href="/forum/thread/?slug=${encodeURIComponent(c.forum_threads.slug)}" class="text-royal hover:underline">${escapeHtml(c.forum_threads.title)}</a>` : "(deleted post)"}
              · ${new Date(c.created_at).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
            </p>
          </div>
        `).join("")
      : `<p class="text-sm text-ink/50">No comments yet.</p>`;

    const likesEl = document.getElementById("tab-likes")!;
    likesEl.innerHTML = likes && likes.length
      ? likes.map((l: any) => l.forum_threads ? `
          <a href="/forum/thread/?slug=${encodeURIComponent(l.forum_threads.slug)}" class="block rounded-xl border border-sand-light bg-white p-4 hover:border-royal">
            <p class="font-medium text-ink">❤️ ${escapeHtml(l.forum_threads.title)}</p>
          </a>
        ` : "").join("")
      : `<p class="text-sm text-ink/50">No liked posts yet.</p>`;
  }

  document.querySelectorAll<HTMLButtonElement>(".tab-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".tab-btn").forEach((b) => {
        b.classList.remove("border-royal", "text-royal");
        b.classList.add("border-transparent", "text-ink/60");
      });
      btn.classList.add("border-royal", "text-royal");
      btn.classList.remove("border-transparent", "text-ink/60");

      document.querySelectorAll(".tab-panel").forEach((p) => p.classList.add("hidden"));
      document.getElementById(`tab-${btn.dataset.tab}`)!.classList.remove("hidden");
    });
  });

  loadProfile();
</script>
