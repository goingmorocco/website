---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Container from "../../../components/Container.astro";
import Button from "../../../components/Button.astro";
---

<BaseLayout
  locale="en"
  title="Set New Password | GoingMorocco"
  description="Set a new password for your GoingMorocco account."
  alternateUrls={{ en: "/account/reset-password/", ar: "/ar/account/reset-password/" }}
>
  <Container class="max-w-md py-16">
    <div id="checking" class="text-center text-ink/50">Verifying your reset link…</div>

    <div id="invalid-link" class="hidden text-center">
      <p class="text-ink/70">This reset link is invalid or has expired.</p>
      <a href="/account/forgot-password/" class="mt-2 inline-block text-royal hover:underline">Request a new one</a>
    </div>

    <div id="reset-form-wrap" class="hidden">
      <h1 class="font-display text-3xl text-ink">Set a new password</h1>

      <form id="reset-form" class="mt-8 space-y-4">
        <div>
          <label for="new-password" class="mb-1 block text-sm font-medium text-ink">New Password</label>
          <input id="new-password" type="password" required minlength="8"
            class="w-full rounded-lg border border-sand-light px-3 py-2 focus:border-royal focus:outline-none" />
        </div>
        <div>
          <label for="confirm-password" class="mb-1 block text-sm font-medium text-ink">Confirm New Password</label>
          <input id="confirm-password" type="password" required minlength="8"
            class="w-full rounded-lg border border-sand-light px-3 py-2 focus:border-royal focus:outline-none" />
        </div>

        <p id="reset-error" class="hidden text-sm text-red-600"></p>
        <p id="reset-success" class="hidden text-sm text-green-700"></p>

        <Button type="submit" class="w-full">Update Password</Button>
      </form>
    </div>
  </Container>
</BaseLayout>

<script>
  import { supabase } from "../../../utils/supabaseClient";

  const checkingEl = document.getElementById("checking")!;
  const invalidEl = document.getElementById("invalid-link")!;
  const formWrapEl = document.getElementById("reset-form-wrap")!;

  // Supabase's reset link puts a recovery token in the URL and the client
  // library exchanges it for a real session automatically — we just need to
  // wait for that PASSWORD_RECOVERY event (or an already-valid session)
  // before showing the form, rather than showing it immediately and having
  // updateUser() fail if the link hasn't finished being processed yet.
  supabase.auth.onAuthStateChange((event, session) => {
    if (event === "PASSWORD_RECOVERY" || (event === "SIGNED_IN" && session)) {
      checkingEl.classList.add("hidden");
      formWrapEl.classList.remove("hidden");
    }
  });

  // Fallback: if there's already a valid session by the time this loads
  // (the event can fire before this listener attaches in some cases).
  setTimeout(async () => {
    if (!formWrapEl.classList.contains("hidden")) return;
    const { data } = await supabase.auth.getSession();
    if (data.session) {
      checkingEl.classList.add("hidden");
      formWrapEl.classList.remove("hidden");
    } else {
      checkingEl.classList.add("hidden");
      invalidEl.classList.remove("hidden");
    }
  }, 3000);

  document.getElementById("reset-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    const errorEl = document.getElementById("reset-error")!;
    const successEl = document.getElementById("reset-success")!;
    errorEl.classList.add("hidden");
    successEl.classList.add("hidden");

    const newPassword = (document.getElementById("new-password") as HTMLInputElement).value;
    const confirmPassword = (document.getElementById("confirm-password") as HTMLInputElement).value;

    if (newPassword !== confirmPassword) {
      errorEl.textContent = "Passwords don't match.";
      errorEl.classList.remove("hidden");
      return;
    }

    const { error } = await supabase.auth.updateUser({ password: newPassword });

    if (error) {
      errorEl.textContent = error.message;
      errorEl.classList.remove("hidden");
      return;
    }

    successEl.textContent = "Password updated! Redirecting you to log in…";
    successEl.classList.remove("hidden");
    setTimeout(() => (window.location.href = "/account/login/"), 2000);
  });
</script>
