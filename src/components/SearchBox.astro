---
interface Props {
  locale: "en" | "ar";
  placeholder: string;
  noResults: string;
  label: string;
  /** Unique suffix so multiple SearchBox instances on one page don't
   * collide on id="site-search" — duplicate IDs meant the search script
   * always bound to whichever instance appeared first in the DOM. */
  instanceId: string;
}
const { locale, placeholder, noResults, label, instanceId } = Astro.props;
const inputId = `site-search-${instanceId}`;
const resultsId = `search-results-${instanceId}`;
---

<div class="relative w-full" data-search-root data-locale={locale}>
  <label for={inputId} class="sr-only">{label}</label>
  <div class="relative flex items-center">
    <svg
      class="pointer-events-none absolute start-3 h-4 w-4 text-ink/40"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path fill-rule="evenodd" d="M9 3a6 6 0 100 12A6 6 0 009 3zM1 9a8 8 0 1114.32 4.906l3.387 3.387a1 1 0 01-1.414 1.414l-3.387-3.387A8 8 0 011 9z" clip-rule="evenodd"/>
    </svg>
    <input
      id={inputId}
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder={placeholder}
      class="w-full rounded-full border border-sand-light bg-white py-2 ps-9 pe-4 text-sm text-ink placeholder-ink/40 focus:border-royal focus:outline-none focus-visible:ring-2 focus-visible:ring-royal"
      aria-autocomplete="list"
      aria-controls={resultsId}
      aria-expanded="false"
    />
  </div>

  <div
    id={resultsId}
    role="listbox"
    data-no-results={noResults}
    class="absolute start-0 top-full z-50 mt-1 hidden w-full min-w-[20rem] overflow-hidden rounded-xl border border-sand-light bg-white shadow-xl"
  ></div>
</div>

<script>
  import { supabase } from "../utils/supabaseClient";

  interface BlogEntry {
    title: string;
    description: string;
    url: string;
    locale: string;
    category: string;
    tags: string[];
  }

  interface MergedResult {
    title: string;
    snippet: string;
    url: string;
    kind: "blog" | "forum";
  }

  let blogIndex: BlogEntry[] | null = null;
  let blogIndexPromise: Promise<void> | null = null;

  async function loadBlogIndex() {
    if (blogIndex) return;
    if (!blogIndexPromise) {
      blogIndexPromise = fetch("/search.json")
        .then((res) => res.json())
        .then((data) => { blogIndex = data; })
        .catch(() => { blogIndex = []; });
    }
    await blogIndexPromise;
  }

  function searchBlog(query: string, locale: string): MergedResult[] {
    if (!blogIndex) return [];
    const q = query.toLowerCase();
    return blogIndex
      .filter(
        (p) =>
          p.locale === locale &&
          (p.title.toLowerCase().includes(q) ||
            p.description.toLowerCase().includes(q) ||
            p.tags.some((t) => t.toLowerCase().includes(q)))
      )
      .slice(0, 5)
      .map((p) => ({ title: p.title, snippet: p.description, url: p.url, kind: "blog" as const }));
  }

  async function searchForum(query: string, locale: string): Promise<MergedResult[]> {
    const { data, error } = await supabase
      .from("forum_threads")
      .select("title, slug")
      .ilike("title", `%${query}%`)
      .limit(5);

    if (error || !data) return [];

    const prefix = locale === "ar" ? "/ar/forum/thread/" : "/forum/thread/";
    return data.map((t) => ({
      title: t.title,
      snippet: locale === "ar" ? "منتدى" : "Forum post",
      url: `${prefix}?slug=${encodeURIComponent(t.slug)}`,
      kind: "forum" as const,
    }));
  }

  function highlight(text: string, query: string): string {
    const escaped = query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return text.replace(new RegExp(`(${escaped})`, "gi"), "<mark class='bg-sand-light rounded px-0.5'>$1</mark>");
  }

  function initInstance(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>("input[type='search']");
    const dropdown = root.querySelector<HTMLElement>("[role='listbox']");
    if (!input || !dropdown) return;

    const locale = root.dataset.locale ?? "en";
    const noResultsLabel = dropdown.dataset.noResults ?? "No results found";
    let activeIndex = -1;
    let requestToken = 0;

    function renderResults(blogResults: MergedResult[], forumResults: MergedResult[], query: string) {
      activeIndex = -1;
      if (!dropdown) return;

      if (blogResults.length === 0 && forumResults.length === 0) {
        dropdown.innerHTML = `<p class="px-4 py-3 text-sm text-ink/60">${noResultsLabel}</p>`;
        showDropdown();
        return;
      }

      const sectionLabel = (label: string) =>
        `<p class="px-4 pb-1 pt-3 text-xs font-semibold uppercase tracking-wide text-ink/40">${label}</p>`;

      const renderGroup = (results: MergedResult[]) =>
        results
          .map(
            (r, i) => `
            <a
              role="option"
              href="${r.url}"
              data-index="${i}"
              class="flex flex-col gap-0.5 px-4 py-3 text-sm hover:bg-sand-light/60 focus:bg-sand-light/60 focus:outline-none border-b border-sand-light/60 last:border-0"
            >
              <span class="font-medium text-ink">${highlight(r.title, query)}</span>
              <span class="text-xs text-ink/60 line-clamp-1">${highlight(r.snippet, query)}</span>
            </a>`
          )
          .join("");

      dropdown.innerHTML =
        (blogResults.length ? sectionLabel(locale === "ar" ? "المدونة" : "Blog") + renderGroup(blogResults) : "") +
        (forumResults.length ? sectionLabel(locale === "ar" ? "المنتدى" : "Forum") + renderGroup(forumResults) : "");

      showDropdown();
    }

    function showDropdown() {
      if (!dropdown || !input) return;
      dropdown.classList.remove("hidden");
      input.setAttribute("aria-expanded", "true");
    }

    function hideDropdown() {
      if (!dropdown || !input) return;
      dropdown.classList.add("hidden");
      input.setAttribute("aria-expanded", "false");
      activeIndex = -1;
    }

    function setActive(i: number) {
      if (!dropdown) return;
      const items = dropdown.querySelectorAll<HTMLElement>("[role='option']");
      items.forEach((el) => el.classList.remove("bg-sand-light/60"));
      activeIndex = Math.max(-1, Math.min(i, items.length - 1));
      if (activeIndex >= 0) {
        items[activeIndex].classList.add("bg-sand-light/60");
        items[activeIndex].scrollIntoView({ block: "nearest" });
      }
    }

    input.addEventListener("focus", loadBlogIndex);

    input.addEventListener("input", async () => {
      const q = input.value.trim();
      if (q.length < 2) { hideDropdown(); return; }

      const myToken = ++requestToken;
      await loadBlogIndex();
      const blogResults = searchBlog(q, locale);
      const forumResults = await searchForum(q, locale);

      // If another keystroke happened while the forum query was in flight,
      // drop this stale response instead of overwriting newer results.
      if (myToken !== requestToken) return;
      renderResults(blogResults, forumResults, q);
    });

    input.addEventListener("keydown", (e) => {
      if (!dropdown) return;
      const items = dropdown.querySelectorAll<HTMLElement>("[role='option']");
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(activeIndex + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(activeIndex - 1); }
      else if (e.key === "Enter" && activeIndex >= 0) { e.preventDefault(); items[activeIndex].click(); }
      else if (e.key === "Escape") hideDropdown();
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) hideDropdown();
    });
  }

  document.querySelectorAll<HTMLElement>("[data-search-root]").forEach(initInstance);
</script>
