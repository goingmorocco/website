---
// Drop this once in the homepage (or BaseLayout, if you want it site-wide
// later). Any element with data-reveal fades and rises into view the first
// time it crosses into the viewport. ~15 lines of vanilla JS, no library,
// respects prefers-reduced-motion, and does nothing until elements are
// actually near the viewport (IntersectionObserver, not a scroll listener).
---

<style is:global>
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
  );

  document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
</script>
