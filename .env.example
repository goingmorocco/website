# Copy this file to .env at your project root and fill in real values.
# Find these in your Supabase project: Settings > API
# Both are safe to expose in the browser (see supabaseClient.ts for why) —
# that's exactly what the PUBLIC_ prefix means to Astro: include in the
# browser bundle, not a server-only secret.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
